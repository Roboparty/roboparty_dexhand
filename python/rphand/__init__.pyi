from typing import Tuple, Union

IntAxes = Tuple[int, int, int, int, int, int]
BoolAxes = Tuple[bool, bool, bool, bool, bool, bool]

class HandState:
    @property
    def positions(self) -> IntAxes: ...
    @property
    def velocities(self) -> IntAxes: ...
    @property
    def currents(self) -> IntAxes: ...
    @property
    def enabled(self) -> BoolAxes: ...
    @property
    def homed(self) -> BoolAxes: ...
    @property
    def torque_reached(self) -> BoolAxes: ...
    @property
    def fault_codes(self) -> IntAxes: ...
    @property
    def feedback_valid(self) -> bool: ...

class Hand:
    def __init__(self) -> None: ...
    def connect(self, can_name: str, node_id: int) -> bool: ...
    def disconnect(self) -> None: ...
    def is_connected(self) -> bool: ...
    def enable(self) -> bool: ...
    def disable(self) -> bool: ...
    def stop(self) -> bool: ...
    def home(self) -> bool: ...
    def set_positions(self, values: Union[list[int], Tuple[int, ...]]) -> bool: ...
    def set_position(self, id: int, position: int) -> bool: ...
    def set_speed(self, speed: int) -> bool: ...
    def set_current_limit(self, current: int) -> bool: ...
    def set_torque_reached_mode(self, stop_on_reached: bool) -> bool: ...
    def get_state(self) -> HandState: ...
