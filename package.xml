  <version>0.1.0</version>
  <description>Dexterous hand driver library with factory pattern (LHandPro, future vendors)</description>
  <maintainer email="dev@roboparty.com">Roboparty</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>roboparty_motors</depend>
  <depend>spdlog</depend>
